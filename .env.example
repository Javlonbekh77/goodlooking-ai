# Google Gemini API Key for GoodLooking AI Hairstyle MVP
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Configure Gemini image editing / multimodal model
# Supported models include: gemini-2.5-flash-image, imagen-3.0-generate-002
# Fal.ai API Key for hair-change model
# Get your API key at: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# OpenAI API Key & Model Configuration
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=low

# Fotor AI API Key (Optional)
FOTOR_API_KEY=your_fotor_api_key_here

# Replicate API Token (Optional)
REPLICATE_API_TOKEN=your_replicate_token_here

